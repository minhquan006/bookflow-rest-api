            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "{{catalogEtag}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/books/{{catalogBookId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Postman Demo Book\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
