{
  "info": {
    "name": "BookFlow Catalog",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Catalog review requests. Run Public in order. Staff requires a local LIBRARIAN/ADMIN accessToken from Auth and creates local demo data. Run Staff in order; each run generates unique category/barcode values. Stored request examples are not evidence that Postman execution passed."
  },
  "variable": [
    {
      "key": "catalogPublicBookId",
      "value": "10000000-0000-4000-8000-000000000001"
    },
    {
      "key": "catalogPublicEtag",
      "value": ""
    },
    {
      "key": "catalogRun",
      "value": ""
    },
    {
      "key": "catalogCategoryId",
      "value": ""
    },
    {
      "key": "catalogBookId",
      "value": ""
    },
    {
      "key": "catalogEtag",
      "value": ""
    },
    {
      "key": "catalogCopyId",
      "value": ""
    },
    {
      "key": "catalogUnusedCategoryId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public - run now",
      "item": [
        {
          "name": "01 List categories",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/categories?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 List books",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/books?page=1&limit=2&sort=title"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Search books",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/books?q=Practical"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Book detail and ETag",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/books/{{catalogPublicBookId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"catalogPublicEtag\", pm.response.headers.get(\"ETag\"));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Conditional GET",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "If-None-Match",
                "value": "{{catalogPublicEtag}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/books/{{catalogPublicBookId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 304\", function () { pm.response.to.have.status(304); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Live availability",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/books/{{catalogPublicBookId}}/availability"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Reject invalid page",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/books?page=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Reject guest archived listing",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/books?includeArchived=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Staff - requires Auth token; writes local demo data",
      "item": [
        {
          "name": "01 Create category",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Category {{catalogRun}}\",\n  \"slug\": \"postman-{{catalogRun}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"catalogRun\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"catalogCategoryId\", pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Replace category",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/categories/{{catalogCategoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Postman Category {{catalogRun}}\",\n  \"slug\": \"updated-postman-{{catalogRun}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Create book",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{catalogCategoryId}}\",\n  \"isbn\": null,\n  \"title\": \"Postman Demo Book\",\n  \"author\": \"BookFlow Demo Team\",\n  \"description\": \"Created by the local Catalog review collection.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"catalogBookId\", pm.response.json().data.id);",
                  "}",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"catalogEtag\", pm.response.headers.get(\"ETag\"));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Patch book",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
