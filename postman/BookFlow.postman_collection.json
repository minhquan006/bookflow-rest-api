{
  "info": {
    "name": "BookFlow \u2014 Foundation smoke",
    "description": "Executable checks for implemented foundation endpoints only. Start PostgreSQL, run migrations, start API, select BookFlow.local environment, and run this collection. Business features are in a separate planned collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Process liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/live",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"BookFlow liveness\", () => { const body=pm.response.json(); pm.expect(body.status).to.eql(\"ok\"); pm.expect(body.service).to.eql(\"bookflow-api\"); });",
              "pm.test(\"Correlation ID\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Database readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/ready",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 after migrations\", () => pm.response.to.have.status(200));",
              "pm.test(\"Ready schema\", () => { const body=pm.response.json(); pm.expect(body.status).to.eql(\"ready\"); pm.expect(body.service).to.eql(\"bookflow-api\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Frontend API connection",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Versioned API\", () => { const data=pm.response.json().data; pm.expect(data.name).to.eql(\"BookFlow API\"); pm.expect(data.version).to.eql(\"v1\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "OpenAPI source",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/openapi.yaml",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"OpenAPI document\", () => pm.expect(pm.response.text()).to.include(\"openapi: 3.1.0\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Swagger documentation",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/docs/",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Swagger UI\", () => pm.expect(pm.response.text()).to.include(\"swagger-ui\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown resource problem",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/does-not-exist",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Problem Details\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); const body=pm.response.json(); pm.expect(body.status).to.eql(404); pm.expect(body.code).to.eql(\"RESOURCE_NOT_FOUND\"); pm.expect(body.requestId).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    }
  ]
}
