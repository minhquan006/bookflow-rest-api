{
  "info": {
    "name": "BookFlow — Implemented API checks",
    "description": "Implemented foundation, Auth and Catalog requests. Auth/Catalog mutations create or modify demo data. Select local environment and enter credentials securely; run login then choose individual Catalog requests with valid IDs/ETags. Do not blindly run all destructive examples. Other modules remain in the planned collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Process liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/live",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"BookFlow liveness\", () => { const body=pm.response.json(); pm.expect(body.status).to.eql(\"ok\"); pm.expect(body.service).to.eql(\"bookflow-api\"); });",
              "pm.test(\"Correlation ID\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
