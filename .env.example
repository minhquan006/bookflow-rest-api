# Use npm run setup to generate ignored local .env files with random credentials.
NODE_ENV=development
HOST=127.0.0.1
# 0 for direct local API; Compose sets 1 behind its sole Nginx hop.
TRUST_PROXY_HOPS=0
PORT=3000
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=
POSTGRES_DB=bookflow
DATABASE_URL=
TEST_DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=bookflow-api
JWT_AUDIENCE=bookflow-client
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
AUTH_RATE_LIMIT_MAX=10
SEED_DEMO_PASSWORD=
